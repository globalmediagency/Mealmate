# ============================================================================
# MealMate — variables d'environnement
# À saisir dans Vercel → Project → Settings → Environment Variables
# (coche "Production" ET "Preview" pour chaque variable).
# Le build ne dépend d'aucune de ces variables : si une clé manque, l'app
# affiche un message "Configuration incomplète" au lieu de planter.
# ============================================================================

# ---- Base de données (Neon) — OBLIGATOIRE dès la phase 1 -------------------
# Neon → Project → Dashboard → "Connection string" → choisir "Pooled connection"
# Format : postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ---- Authentification (Better Auth) — OBLIGATOIRE dès la phase 1 -----------
# Secret aléatoire d'au moins 32 caractères. Générateur en ligne :
# https://generate-secret.vercel.app/32  (ou n'importe quelle chaîne longue et aléatoire)
BETTER_AUTH_SECRET=

# URL publique de production (sans slash final). Optionnelle : sert de
# repli et autorise ce domaine en plus de *.vercel.app.
# Ex. https://mealmate.vercel.app ou https://mealmate.fr
APP_URL=

# Hôtes supplémentaires autorisés pour l'auth (séparés par des virgules),
# utile si tu ajoutes un domaine personnalisé. Ex. mealmate.fr,www.mealmate.fr
AUTH_ALLOWED_HOSTS=

# ---- Espace admin (/admin) — phase 4 ----------------------------------------
# Identifiant et mot de passe de l'espace d'administration (règles de jeu).
# Choisis un mot de passe long ; le changer déconnecte toutes les sessions admin.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ---- Connexion Google (optionnelle) -----------------------------------------
# Google Cloud Console → APIs & Services → Credentials → "OAuth client ID"
# (type "Web application"). Redirect URI à déclarer :
#   https://TON-DOMAINE/api/auth/callback/google
# Le bouton Google n'apparaît que si les deux variables sont présentes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Cloudflare R2 (photos de repas) — phase 3 ------------------------------
# Cloudflare → R2 → "Manage R2 API Tokens" → créer un token (Object Read & Write)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mealmate

# ---- Google Gemini (analyse des repas) — phase 3 ----------------------------
# Google AI Studio → "Get API key"
GEMINI_API_KEY=
# Modèle à utiliser. Vide = automatique : l'app interroge la liste des modèles
# de ta clé et choisit le dernier "gemini-X.Y-flash" stable, avec repli sur
# gemini-3.8-flash → gemini-3.6-flash → gemini-3.5-flash-lite → gemini-2.5-flash.
# La page /dev/gemini (NEXT_PUBLIC_DEV_GALLERY=true) montre les modèles visibles.
GEMINI_MODEL=

# ---- Stripe (boutique, mode test) — phase 7 ---------------------------------
# Stripe → Developers → API keys (clé secrète "sk_test_…")
STRIPE_SECRET_KEY=
# Stripe → Developers → Webhooks → endpoint https://TON-DOMAINE/api/webhooks/stripe
# → "Signing secret" ("whsec_…")
STRIPE_WEBHOOK_SECRET=

# ---- Strava (import d'activités) — phase 8 ----------------------------------
# https://www.strava.com/settings/api → "Authorization Callback Domain" = ton domaine
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# ---- Options publiques (exposées au navigateur) -----------------------------
# Affiche la galerie /dev/creatures (phase 2) : true / false
NEXT_PUBLIC_DEV_GALLERY=false
# Email de contact affiché dans les mentions légales
NEXT_PUBLIC_CONTACT_EMAIL=
